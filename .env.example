# モラサン environment. Copy to ./.env.local (gitignored) and fill in. Never commit real values.
# Auth is Application Default Credentials: gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=useful-cathode-450302-f0
# Vertex AI location for Gemini. "global" serves the newest models.
GOOGLE_CLOUD_LOCATION=global
# Model IDs, only from env. Never Gemini 2.5 (npm run check:models refuses /2\.5/).
MODEL_FAST=
MODEL_SMART=
# Firestore database (collections: requests, audit).
FIRESTORE_DATABASE_ID=morasan
# Only this logged-in user may approve/deny held requests.
DATA_OWNER_EMAIL=owner@morasan.demo

# Firebase web app config (Console → Project settings → Your apps). Public by design; inlined at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo account passwords (min 10 chars) for npm run seed:users / scripts/smoke.ts. Submission form only.
SEED_PASSWORD_STAFF=
SEED_PASSWORD_OWNER=
